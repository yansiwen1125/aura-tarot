# Copy to .env, then set your DeepSeek key locally. Never send it in chat.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_READING=deepseek-v4-pro
DEEPSEEK_MODEL_REVIEW=deepseek-v4-pro
DEEPSEEK_MODEL_CONTEXT=deepseek-flash
AI_MAX_OUTPUT_TOKENS=16000
AI_TOTAL_TIMEOUT_MS=180000
# Conservative reserved token budget per UTC day, persisted across restarts.
AI_DAILY_TOKEN_LIMIT=1000000
